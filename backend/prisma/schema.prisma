generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  BURSAR
  TEACHER
  SCHOOL_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LearnerStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  LEFT_SCHOOL
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  REVERSED
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

// ============================================
// USER
// ============================================

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?    @unique
  password     String
  role         UserRole   @default(BURSAR)
  status       UserStatus @default(ACTIVE)

  payments     Payment[]
  auditLogs    AuditLog[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
}

// ============================================
// ACADEMIC YEAR
// ============================================

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  learners      Learner[]
  feeStructures FeeStructure[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ============================================
// GRADE
// ============================================

model Grade {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)

  classes       SchoolClass[]
  learners      Learner[]
  feeStructures FeeStructure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================
// CLASS / STREAM
// ============================================

model SchoolClass {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)

  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  learners  Learner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gradeId])
  @@index([name])
}

// ============================================
// LEARNER
// ============================================

model Learner {
  id             String         @id @default(cuid())
  admissionNumber String        @unique

  firstName      String
  middleName     String?
  lastName       String

  gender         Gender?
  dateOfBirth    DateTime?

  admissionDate  DateTime       @default(now())

  status         LearnerStatus  @default(ACTIVE)

  address        String?
  phone          String?
  profilePhoto   String?
  notes          String?

  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  gradeId        String
  grade          Grade          @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  classId        String?
  schoolClass    SchoolClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  parents        LearnerParent[]
  payments       Payment[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([firstName])
  @@index([lastName])
  @@index([admissionNumber])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([classId])
  @@index([status])
}

// ============================================
// PARENT / GUARDIAN
// ============================================

model Parent {
  id             String          @id @default(cuid())

  firstName      String
  lastName       String

  phone          String
  alternativePhone String?
  email          String?

  nationalId     String?         @unique
  address        String?
  occupation     String?
  emergencyContact String?
  notes          String?

  learners       LearnerParent[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([firstName])
  @@index([lastName])
  @@index([phone])
}

// ============================================
// LEARNER-PARENT RELATIONSHIP
// ============================================

model LearnerParent {
  id             String         @id @default(cuid())

  learnerId      String
  parentId       String

  relationship   RelationshipType
  isPrimary      Boolean        @default(false)

  learner        Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  parent         Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now())

  @@unique([learnerId, parentId])
  @@index([learnerId])
  @@index([parentId])
}

// ============================================
// FEE CATEGORY
// ============================================

model FeeCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  isActive    Boolean        @default(true)

  feeStructures FeeStructure[]
  allocations   PaymentAllocation[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ============================================
// FEE STRUCTURE
// ============================================

model FeeStructure {
  id             String       @id @default(cuid())

  academicYearId String
  gradeId        String

  term           Int

  feeCategoryId  String
  amount         Decimal      @db.Decimal(12, 2)

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, gradeId, term, feeCategoryId])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([term])
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id                String        @id @default(cuid())

  receiptNumber     String        @unique

  learnerId         String
  academicYearId    String

  amount            Decimal       @db.Decimal(12, 2)

  paymentMethod     PaymentMethod
  transactionNumber String?

  paymentDate       DateTime      @default(now())

  status            PaymentStatus @default(COMPLETED)

  remarks           String?

  receivedById      String

  learner           Learner       @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  academicYear      AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  receivedBy        User          @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  allocations       PaymentAllocation[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([learnerId])
  @@index([academicYearId])
  @@index([paymentDate])
  @@index([amount])
  @@index([paymentMethod])
  @@index([transactionNumber])
  @@index([status])
}

// ============================================
// PAYMENT ALLOCATION
// ============================================

model PaymentAllocation {
  id            String       @id @default(cuid())

  paymentId     String
  feeCategoryId String

  amount        Decimal      @db.Decimal(12, 2)

  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeCategory   FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)

  createdAt     DateTime     @default(now())

  @@index([paymentId])
  @@index([feeCategoryId])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())

  userId      String?

  action      String
  entity      String
  entityId    String?

  oldValue    Json?
  newValue    Json?

  ipAddress   String?

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}